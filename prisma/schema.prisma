generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model OnboardingRequest {
  id         String           @id @default(cuid())
  name       String
  title      String
  department String
  startDate  DateTime
  manager    String
  status     String           @default("Pending")
  createdAt  DateTime         @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}